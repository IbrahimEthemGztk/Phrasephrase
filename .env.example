# Bu dosyayı .env olarak kopyala ve değerleri doldur. .env repoya EKLENMEZ.

DJANGO_DEBUG=True
# Üretmek için: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Supabase Dashboard > Connect > "Session pooler" (yerel geliştirme) veya
# "Transaction pooler" (Vercel) bağlantı dizesi. [YOUR-PASSWORD] yerine DB parolan.
# Boş bırakılırsa ve DJANGO_DEBUG=True ise yerel SQLite kullanılır.
DATABASE_URL=

# AI ile phrase üretimi (Google Gemini). Anahtarı Google AI Studio'dan (aistudio.google.com) al.
# Boş bırakılırsa "AI ile üret" seçeneği pasif görünür, manuel ekleme çalışmaya devam eder.
GEMINI_API_KEY=
# İsteğe bağlı ayarlar (varsayılanlar):
# AI_MODEL=gemini-3.5-flash-lite # varsayılan (hızlı, ücretsiz kotası geniş). En iyi kalite: gemini-3.8-flash
#                                # (ücretsiz katmanda günde ~20 istek; ücretli katmanda üretim başına ~0,13 sent)
# AI_THINKING_LEVEL=low          # minimal | low | medium | high (boş = modelin varsayılanı)
# AI_TIMEOUT_SECONDS=20          # tek bir API denemesi için; en kötü durumda 1 yeniden deneme eklenir
# AI_DAILY_LIMIT=20              # kullanıcı başına günlük üretim hakkı
