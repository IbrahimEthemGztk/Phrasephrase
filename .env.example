# Bu dosyayı .env olarak kopyala ve değerleri doldur. .env repoya EKLENMEZ.

DJANGO_DEBUG=True
# Üretmek için: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Supabase Dashboard > Connect > "Session pooler" (yerel geliştirme) veya
# "Transaction pooler" (Vercel) bağlantı dizesi. [YOUR-PASSWORD] yerine DB parolan.
# Boş bırakılırsa ve DJANGO_DEBUG=True ise yerel SQLite kullanılır.
DATABASE_URL=

